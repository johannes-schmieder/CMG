{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johannes-schmieder/CMG/benchmarks/scc2/schemas/result.schema.json",
  "title": "CMG SCC2 configuration result",
  "type": "object",
  "required": [
    "protocol_version", "run_id", "task_id", "source_commit", "source_archive_sha256",
    "binary_sha256", "environment_id", "implementation", "experiment", "family", "vertices",
    "canonical_edges", "matrix_nonzeros", "strategy", "hierarchy_threads", "plan_threads",
    "solve_threads", "rhs_count", "warmups", "repetitions", "tolerance", "max_iterations",
    "samples", "hierarchy", "numerical", "memory", "placement", "success", "warnings"
  ],
  "properties": {
    "protocol_version": {"const": "cmg-scc2-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "integer", "minimum": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation": {"enum": ["rust", "matlab"]},
    "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}},
    "success": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": ["repetition", "order_position", "started_at_utc", "stage", "wall_ns", "process_cpu_ns"],
      "properties": {
        "repetition": {"type": "integer", "minimum": 0},
        "order_position": {"type": "integer", "minimum": 1},
        "started_at_utc": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "wall_ns": {"type": "number", "minimum": 0},
        "process_cpu_ns": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
